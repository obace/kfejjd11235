<%- include('partials/head', { title: '管理后台' }) %>

  <!-- 悬浮胶囊顶栏 -->
  <header class="max-w-7xl mx-auto px-4 sm:px-6 pt-3">
    <nav class="glass-solid rounded-2xl px-4 sm:px-5 py-2.5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center text-sm shadow" style="background:linear-gradient(135deg,var(--accent),#6366f1);color:#fff">🍑</div>
        <div>
          <span class="text-white font-semibold text-sm block leading-tight">大姨子的后台</span>
          <span class="text-[10px] text-gray-500 hidden sm:block">Control Center</span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a href="/" class="text-xs px-3.5 py-1.5 rounded-xl glass text-gray-300 hover:text-white transition">返回面板</a>
        <a href="/auth/logout" class="text-xs px-3.5 py-1.5 rounded-xl glass text-gray-300 hover:text-red-400 transition">退出</a>
      </div>
    </nav>
  </header>

  <!-- 移动端快速切换（lg 以下显示） -->
  <div class="lg:hidden max-w-7xl mx-auto px-4 sm:px-6 pt-3">
    <select id="tab-select" class="w-full bg-black/30 text-white px-3 py-2 rounded-xl border border-white/10 text-sm mb-2">
      <optgroup label="核心业务">
        <option value="nodes">🌐 节点管理</option>
        <option value="users">👥 用户管理</option>
        <option value="traffic">📊 流量统计</option>
      </optgroup>
      <optgroup label="监控安全">
        <option value="logs">📋 日志审计</option>
        <option value="abuse">🛡️ 安全风控</option>
      </optgroup>
      <optgroup label="系统配置">
        <option value="notify">🔔 通知配置</option>
        <option value="aws">☁️ AWS 实例</option>
        <option value="settings">⚙️ 系统设置</option>
        <option value="backup">💾 数据备份</option>
      </optgroup>
    </select>
  </div>

  <!-- 主工作区：桌面端左侧边栏 + 右侧内容区 -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex flex-col lg:flex-row gap-5">
    <aside class="hidden lg:flex lg:flex-col lg:w-52 shrink-0 glass rounded-2xl p-3 h-fit sticky top-5 sidebar-nav space-y-4" role="tablist" aria-label="后台功能标签">
      <div>
        <div class="px-2.5 mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-gray-500">核心业务</div>
        <div class="space-y-1">
          <button class="tab-btn active text-xs" data-tab="nodes" role="tab" aria-selected="true" aria-controls="tab-panel-nodes" id="tab-btn-nodes"><span>🌐</span><span>节点管理</span></button>
          <button class="tab-btn text-xs" data-tab="users" role="tab" aria-selected="false" aria-controls="tab-panel-users" id="tab-btn-users"><span>👥</span><span>用户管理</span></button>
          <button class="tab-btn text-xs" data-tab="traffic" role="tab" aria-selected="false" aria-controls="tab-panel-traffic" id="tab-btn-traffic"><span>📊</span><span>流量统计</span></button>
        </div>
      </div>
      <div>
        <div class="px-2.5 mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-gray-500">监控安全</div>
        <div class="space-y-1">
          <button class="tab-btn text-xs" data-tab="logs" role="tab" aria-selected="false" aria-controls="tab-panel-logs" id="tab-btn-logs"><span>📋</span><span>日志审计</span></button>
          <button class="tab-btn text-xs" data-tab="abuse" role="tab" aria-selected="false" aria-controls="tab-panel-abuse" id="tab-btn-abuse"><span>🛡️</span><span>安全风控</span></button>
        </div>
      </div>
      <div>
        <div class="px-2.5 mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-gray-500">系统配置</div>
        <div class="space-y-1">
          <button class="tab-btn text-xs" data-tab="notify" role="tab" aria-selected="false" aria-controls="tab-panel-notify" id="tab-btn-notify"><span>🔔</span><span>通知配置</span></button>
          <button class="tab-btn text-xs" data-tab="aws" role="tab" aria-selected="false" aria-controls="tab-panel-aws" id="tab-btn-aws"><span>☁️</span><span>AWS 实例</span></button>
          <button class="tab-btn text-xs" data-tab="settings" role="tab" aria-selected="false" aria-controls="tab-panel-settings" id="tab-btn-settings"><span>⚙️</span><span>系统设置</span></button>
          <button class="tab-btn text-xs" data-tab="backup" role="tab" aria-selected="false" aria-controls="tab-panel-backup" id="tab-btn-backup"><span>💾</span><span>数据备份</span></button>
        </div>
      </div>
    </aside>

    <main class="flex-1 min-w-0">
      <%- include('partials/admin-nodes') %>
      <%- include('partials/admin-sections') %>
      <%- include('partials/admin-traffic') %>
      <%- include('partials/admin-backup') %>
    </main>
  </div>

  <style nonce="<%= nonce %>">
    .tab-btn{color:#9ca3af;transition:all .15s}.tab-btn:hover{color:#fff;background:rgba(255,255,255,0.06)}
    .tab-btn.active{color:#fff;background:rgba(244,63,94,0.2);font-weight:600}
    .tab-panel{display:none}.tab-panel.active{display:block}
  </style>
  <script src="/js/chart.umd.min.js"></script>
  <script src="/js/admin/utils.js"></script>
  <script src="/js/admin/core.js"></script>
  <script src="/js/admin/aws.js"></script>
  <script src="/js/admin/traffic.js"></script>
  <script src="/js/admin/users.js?v=20260601-nodeloc-default-group"></script>
  <script src="/js/admin/logs.js"></script>
  <script src="/js/admin/substats.js"></script>
  <script src="/js/admin/notify.js"></script>
  <script nonce="<%= nonce %>">
    const tabSelect = document.getElementById('tab-select');
    if (tabSelect) {
      tabSelect.addEventListener('change', (e) => {
        switchTab(e.target.value);
      });
    }
    document.querySelectorAll('.tab-btn[data-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (tabSelect) tabSelect.value = btn.dataset.tab;
        switchTab(btn.dataset.tab);
      });
    });
  </script>
<%- include('partials/foot') %>