<%- include('partials/head', { title: '登录' }) %>

  <main class="min-h-screen flex items-center justify-center px-4 py-10 relative z-10" role="main" aria-label="登录">
    <div class="glass rounded-3xl overflow-hidden max-w-3xl w-full flex flex-col md:flex-row">
      <!-- 左侧品牌视觉展示区（桌面端） -->
      <div class="hidden md:flex md:w-5/12 flex-col justify-between p-8 border-r border-white/10" style="background:linear-gradient(155deg,var(--accent-soft),transparent 70%)">
        <div>
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl mb-5 shadow-lg" style="background:linear-gradient(135deg,var(--accent),#6366f1);color:#fff" aria-hidden="true">🍑</div>
          <h1 class="text-2xl font-bold text-white tracking-tight mb-2">大姨子的诱惑</h1>
          <p class="text-gray-400 text-xs leading-relaxed">轻量级多协议节点控制中心，支持订阅一键导入、TG 农场互动与智能节点巡检。</p>
        </div>
        <div class="space-y-2.5 text-xs text-gray-300 mt-8">
          <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-black/20 border border-white/5">
            <span>⚡</span><span>VLESS / Hysteria 2 多协议支持</span>
          </div>
          <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-black/20 border border-white/5">
            <span>🌾</span><span>每日签到与农场种菜领流量</span>
          </div>
          <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-black/20 border border-white/5">
            <span>🛡️</span><span>实时连通性巡检与自动切换</span>
          </div>
        </div>
      </div>

      <!-- 右侧登录表单 -->
      <div class="w-full md:w-7/12 p-7 sm:p-10">
        <div class="md:hidden text-center mb-6">
          <div class="w-14 h-14 mx-auto rounded-2xl flex items-center justify-center text-3xl mb-3 shadow-lg" style="background:linear-gradient(135deg,var(--accent),#6366f1);color:#fff" aria-hidden="true">🍑</div>
          <h1 class="text-xl font-bold text-white">大姨子的诱惑</h1>
          <p class="text-gray-500 text-xs mt-0.5 tracking-widest">WELCOME BACK</p>
        </div>
        <div class="hidden md:block mb-6">
          <h2 class="text-lg font-semibold text-white">欢迎回来</h2>
          <p class="text-gray-500 text-xs mt-1">请选择以下方式登录您的账号</p>
        </div>

        <% if (error) { %>
          <div class="rounded-xl p-3 mb-5 border border-red-500/20 bg-red-500/10" role="alert">
            <p class="text-red-400 text-xs"><%= error %></p>
          </div>
        <% } %>
        <% if (message) { %>
          <div class="rounded-xl p-3 mb-5 border border-emerald-500/20 bg-emerald-500/10" role="status">
            <p class="text-emerald-400 text-xs"><%= message %></p>
          </div>
        <% } %>

        <% if (nodelocLoginOpen) { %>
          <a href="/auth/nodeloc" class="block w-full bg-rose-600 hover:bg-rose-500 text-white font-semibold py-2.5 px-5 rounded-xl text-sm text-center mb-4 transition shadow-md" role="button">
            使用 NodeLoc 一键登录
          </a>
          <% if (!nodelocConfigured) { %>
            <p class="text-amber-400 text-xs mb-4 text-center">NodeLoc 登录尚未配置，管理员请先设置 OAuth 凭据。</p>
          <% } %>
          <div class="flex items-center gap-3 my-4 text-gray-500 text-[11px]">
            <span class="flex-1 h-px bg-white/10"></span><span>或使用邮箱登录</span><span class="flex-1 h-px bg-white/10"></span>
          </div>
        <% } %>

        <form method="POST" action="/auth/email-login" class="space-y-4">
          <div>
            <label class="text-gray-500 text-xs block mb-1.5 ml-0.5">邮箱</label>
            <div class="relative">
              <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
              <input type="email" name="email" autocomplete="username" required class="login-inp" placeholder="请输入邮箱">
            </div>
          </div>
          <div>
            <label class="text-gray-500 text-xs block mb-1.5 ml-0.5">密码</label>
            <div class="relative">
              <svg class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
              <input type="password" name="password" autocomplete="current-password" required class="login-inp" placeholder="请输入密码">
            </div>
          </div>
          <button type="submit" class="w-full bg-rose-600 hover:bg-rose-500 text-white font-semibold py-2.5 px-6 rounded-xl text-sm transition shadow-md">登 录</button>
        </form>

        <div class="mt-4 flex items-center justify-between text-xs">
          <% if (registrationOpen || firstUserMode) { %>
            <a href="/auth/email-register" class="text-rose-400 hover:underline font-medium" role="button">注册新账号</a>
          <% } else { %>
            <span></span>
          <% } %>
          <a href="/auth/forgot-password" class="text-gray-500 hover:text-rose-400 transition">忘记密码？</a>
        </div>
      </div>
    </div>
  </main>

<%- include('partials/foot') %>
